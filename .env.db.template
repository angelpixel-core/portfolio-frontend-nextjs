# Database operations environment template
# Copy to .env.db.production (or export directly in shell) before running db:prod:* scripts.

# Required by scripts/db/prod-*.sh
# Runtime-safe production format (Node/pg + Supabase pooler):
#   ...?sslmode=require&uselibpqcompat=true
#
# Notes:
# - uselibpqcompat=true is needed by node/pg runtime/migrations for some pooler setups.
# - psql does NOT support uselibpqcompat; repo scripts strip it automatically for psql checks.
# - Non-standard pooler params like supa=... are stripped automatically for psql checks.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require&uselibpqcompat=true

# Optional toggles
# true  -> fail db:prod:check when required tables are missing
# false -> warn and continue (default)
DB_CHECK_TABLES_STRICT=true

# true  -> enforce secure TLS params in DATABASE_URL (default)
# false -> skip TLS URL validation
DB_ENFORCE_TLS_URL=true

# true  -> skip precheck phase inside db:prod:migrate
# false -> run precheck before migration (default)
DB_SKIP_PRECHECK=false
