# Vercel environment example (safe to commit)
# Copy to `.env.vercel` locally and set real values in Vercel dashboard.

# Public runtime
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com
NEXT_PUBLIC_OAUTH_ENABLED=false
NEXT_PUBLIC_MONETIZATION_MODE=subscribe

# Subscribe lifecycle
SUBSCRIBE_TOKEN_TTL_HOURS=24
SUBSCRIBE_RESEND_COOLDOWN_MINUTES=15
SUBSCRIBE_RESEND_MAX_PER_DAY=3
SUBSCRIBE_MIN_FORM_DURATION_MS=2500
SUBSCRIBE_RATE_LIMIT_MAX=8
SUBSCRIBE_RATE_LIMIT_WINDOW_MS=60000
SUBSCRIBE_TOKEN_SECRET=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Site / backend
SITE_URL=https://your-domain.com
DATABASE_URL=
BETTER_AUTH_SECRET=

# Email provider
POSTMARK_SERVER_TOKEN=
POSTMARK_SENDER_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_ARTICLE_PATTERN=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin allowlist
ADMIN_EMAILS=admin@your-domain.com,admin@local.com
