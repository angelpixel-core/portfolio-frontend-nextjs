# =============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# =============================================================================
# All NEXT_PUBLIC_* variables are exposed to the browser (client-side)
# Non-prefixed variables are server-side only
# For Vercel production (mock mode + auth disabled), use `.env.vercel` as guide.
# =============================================================================

# -----------------------------------------------------------------------------
# OWNER / AUTHOR IDENTITY
# -----------------------------------------------------------------------------
# Author name displayed in footer "by {AUTHOR_NAME}"
NEXT_PUBLIC_AUTHOR_NAME=Angel Szymczak
NEXT_PUBLIC_AUTHOR_ROLE=Software Engineer

# -----------------------------------------------------------------------------
# SOCIAL NETWORK IDENTIFIERS
# -----------------------------------------------------------------------------
# Only the username/identifier - component builds the full URL
# Pattern: https://{platform}.com/{IDENTIFIER}

# LinkedIn: https://linkedin.com/in/{IDENTIFIER}
NEXT_PUBLIC_LINKEDIN_USERNAME=minba

# GitHub: https://github.com/{IDENTIFIER}
NEXT_PUBLIC_GITHUB_USERNAME=someguy-io

# Twitter/X: https://twitter.com/{IDENTIFIER}
NEXT_PUBLIC_TWITTER_USERNAME=someguyio

# Dribbble: https://dribbble.com/{IDENTIFIER}
NEXT_PUBLIC_DRIBBBLE_USERNAME=someguy

# Telegram: https://t.me/{IDENTIFIER}
NEXT_PUBLIC_TELEGRAM_USERNAME=someguy-sz

# WhatsApp: https://wa.me/{PHONE_NUMBER} (include country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE=5491122334455

# Calendly: https://calendly.com/{IDENTIFIER}
NEXT_PUBLIC_CALENDLY_USERNAME=someguy

# -----------------------------------------------------------------------------
# CONTACT INFORMATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=contact@someguy.io

# -----------------------------------------------------------------------------
# ANALYTICS (Plausible)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=angelpixel.io
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# -----------------------------------------------------------------------------
# CONTACT DELIVERY (Postmark)
# -----------------------------------------------------------------------------
POSTMARK_SERVER_TOKEN=
POSTMARK_SENDER_EMAIL=
POSTMARK_RECIPIENT_EMAIL=

# -----------------------------------------------------------------------------
# RATE LIMITING (Upstash)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_RATE_LIMIT_MAX=5
UPSTASH_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# EXTERNAL URLS (Full URLs - not built from pattern)
# -----------------------------------------------------------------------------
# Resume/CV document (Google Drive, Proton Drive, etc.)
NEXT_PUBLIC_RESUME_URL=https://drive.proton.me/urls/WTJBRJFV74#myTCLYPcLKLl

# -----------------------------------------------------------------------------
# CONTENT SOURCES (ENV-FIRST)
# -----------------------------------------------------------------------------
# Content domains resolve from env first; HTTP fallback occurs only when empty.
# Values can be inline JSON or file references: file:<name>.json
# File references map to src/environment-content/<name>.json
# Example: NEXT_PUBLIC_CONTENTS=file:contents.json
NEXT_PUBLIC_CONTENTS=file:contents.json
NEXT_PUBLIC_PROFILES=file:profiles.json
NEXT_PUBLIC_NAV_ITEMS=file:navigation-items.json
NEXT_PUBLIC_CUSTOMERS=file:customers.json
NEXT_PUBLIC_TECHNOLOGIES=file:technologies.json
NEXT_PUBLIC_WORD_CLOUD_CONCEPTS=file:word-cloud-concepts.json

# -----------------------------------------------------------------------------
# HERO SECTION
# -----------------------------------------------------------------------------
# Hero image source (path to asset or external URL)
NEXT_PUBLIC_HERO_IMAGE=/images/profile/hero.png

# Hero click destination (which social profile to link to)
# Options: linkedin, github, calendly, telegram, etc.
NEXT_PUBLIC_HERO_LINK_PROVIDER=linkedin

# -----------------------------------------------------------------------------
# HEADER / LOGO
# -----------------------------------------------------------------------------
# Logo image source (path to asset or external URL)
NEXT_PUBLIC_LOGO_IMAGE=/images/logo.svg

# "Hire Me" button destination provider
# Options: telegram, calendly, whatsapp, etc.
NEXT_PUBLIC_HIRE_ME_PROVIDER=telegram

# -----------------------------------------------------------------------------
# PAGE CONTENT (Legacy - replaced by NEXT_PUBLIC_CONTENTS/PROFILES)
# -----------------------------------------------------------------------------
# Home Page
NEXT_PUBLIC_HOME_TITLE=Software Engineer
NEXT_PUBLIC_HOME_DESCRIPTION=tuvieja
NEXT_PUBLIC_HOME_CONTENT=Designing and building scalable web systems powering real-world products.
NEXT_PUBLIC_SITE_KEYWORDS=Web Developer,Full Stack Developer,React,Next.js,JavaScript,TypeScript,Ruby,Rails,Portfolio,Software Engineer,Frontend Developer

# About Page
NEXT_PUBLIC_ABOUT_TITLE=About Me
NEXT_PUBLIC_ABOUT_DESCRIPTION=Passion Fuels Purpose — building solutions that empower users.
NEXT_PUBLIC_ABOUT_CONTENT=Software Engineer focused on building scalable systems and real-world products.
NEXT_PUBLIC_ABOUT_ROLE=Software Engineer • Systems • Realtime Platforms
NEXT_PUBLIC_ABOUT_DETAILS_TEXT=I design web architectures that balance performance, maintainability, and user experience.
# Core focus entries separated by comma, pipe, or new lines
NEXT_PUBLIC_ABOUT_CORE_FOCUS=System Design,Scalable Web Architectures,Product Engineering

# -----------------------------------------------------------------------------
# UI / UX SETTINGS
# -----------------------------------------------------------------------------
# Transition Animation - Pause duration (ms) when curtain covers screen
NEXT_PUBLIC_TRANSITION_PAUSE_MS=4

# -----------------------------------------------------------------------------
# AUTHENTICATION / OAUTH
# -----------------------------------------------------------------------------
# Set to "true" when Rails backend OAuth is ready
# Vercel release without auth should use: NEXT_PUBLIC_OAUTH_ENABLED=false
NEXT_PUBLIC_OAUTH_ENABLED=false

# Better Auth
BETTER_AUTH_URL=http://localhost:9000
BETTER_AUTH_SECRET=

# Two-Factor Authentication (TOTP)
TWO_FACTOR_ISSUER=Angel Solutions
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_RECOVERY_PEPPER=

# Social Providers (Better Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# API CONFIGURATION (Production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_HOST="http://localhost"
NEXT_PUBLIC_BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# SITE URL (server-side)
# -----------------------------------------------------------------------------
# Used by next-sitemap for robots.txt and sitemap generation.
# Also used for Open Graph meta tags (og:url).
# Must be the full production URL (e.g., https://yourdomain.com).
# If missing, sitemap defaults to localhost:3000.
SITE_URL=https://angelpixel.io

# -----------------------------------------------------------------------------
# LEGACY (will be removed) -- kept for backward compat
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_USE_MOCKS: Deprecated (no runtime mock selection)
NEXT_PUBLIC_USE_MOCKS=true

# PROFILE_EMAIL: Use NEXT_PUBLIC_CONTACT_EMAIL instead (CI sets to test@ci.local)
PROFILE_EMAIL=contact@someguy.io

# RESUME_URL: Use NEXT_PUBLIC_RESUME_URL instead
RESUME_URL=

# CALENDLY_URL: Use NEXT_PUBLIC_CALENDLY_USERNAME instead
NEXT_PUBLIC_CALENDLY_URL=

# TELEGRAM_URL: Use NEXT_PUBLIC_TELEGRAM_USERNAME instead
NEXT_PUBLIC_TELEGRAM_URL=

# WHATSAPP_URL: Use NEXT_PUBLIC_WHATSAPP_PHONE instead
NEXT_PUBLIC_WHATSAPP_URL=

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY (Database, APIs)
# -----------------------------------------------------------------------------
WEB_PORT=9000

# ------------------------------------------------------------------------------
# Database (Postgres superuser)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_frontend_development

