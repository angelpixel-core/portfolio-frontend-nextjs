# =============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES
# =============================================================================
# All NEXT_PUBLIC_* variables are exposed to the browser (client-side)
# Non-prefixed variables are server-side only
# For Vercel production (mock mode + auth disabled), use `.env.vercel` as guide.
# =============================================================================

# -----------------------------------------------------------------------------
# MOCK MODE
# -----------------------------------------------------------------------------
# Set to "true" to use local mock data instead of API
# Vercel release without backend/auth should use: NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_USE_MOCKS=true

# -----------------------------------------------------------------------------
# OWNER / AUTHOR IDENTITY
# -----------------------------------------------------------------------------
# Author name displayed in footer "by {AUTHOR_NAME}"
NEXT_PUBLIC_AUTHOR_NAME=

# -----------------------------------------------------------------------------
# SOCIAL NETWORK IDENTIFIERS
# -----------------------------------------------------------------------------
# Only the username/identifier - component builds the full URL
# Pattern: https://{platform}.com/{IDENTIFIER}

# LinkedIn: https://linkedin.com/in/{IDENTIFIER}
NEXT_PUBLIC_LINKEDIN_USERNAME=

# GitHub: https://github.com/{IDENTIFIER}
NEXT_PUBLIC_GITHUB_USERNAME=

# Twitter/X: https://twitter.com/{IDENTIFIER}
NEXT_PUBLIC_TWITTER_USERNAME=

# Dribbble: https://dribbble.com/{IDENTIFIER}
NEXT_PUBLIC_DRIBBBLE_USERNAME=

# Telegram: https://t.me/{IDENTIFIER}
NEXT_PUBLIC_TELEGRAM_USERNAME=

# WhatsApp: https://wa.me/{PHONE_NUMBER} (include country code, no + or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE=

# Calendly: https://calendly.com/{IDENTIFIER}
NEXT_PUBLIC_CALENDLY_USERNAME=

# -----------------------------------------------------------------------------
# CONTACT INFORMATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# EXTERNAL URLS (Full URLs - not built from pattern)
# -----------------------------------------------------------------------------
# Resume/CV document (Google Drive, Proton Drive, etc.)
NEXT_PUBLIC_RESUME_URL=

# -----------------------------------------------------------------------------
# HERO SECTION
# -----------------------------------------------------------------------------
# Hero image source (path to asset or external URL)
NEXT_PUBLIC_HERO_IMAGE=/images/profile/hero.png

# Hero click destination (which social profile to link to)
# Options: linkedin, github, calendly, telegram, etc.
NEXT_PUBLIC_HERO_LINK_PROVIDER=linkedin

# -----------------------------------------------------------------------------
# HEADER / LOGO
# -----------------------------------------------------------------------------
# Logo image source (path to asset or external URL)
NEXT_PUBLIC_LOGO_IMAGE=/images/logo.svg

# "Hire Me" button destination provider
# Options: telegram, calendly, whatsapp, etc.
NEXT_PUBLIC_HIRE_ME_PROVIDER=telegram

# -----------------------------------------------------------------------------
# PAGE CONTENT
# -----------------------------------------------------------------------------
# Home Page
NEXT_PUBLIC_HOME_TITLE=
NEXT_PUBLIC_HOME_DESCRIPTION=
NEXT_PUBLIC_HOME_CONTENT=

# About Page
NEXT_PUBLIC_ABOUT_TITLE=
NEXT_PUBLIC_ABOUT_DESCRIPTION=
NEXT_PUBLIC_ABOUT_CONTENT=
NEXT_PUBLIC_ABOUT_ROLE=Software Engineer · Systems Thinking · Product Engineering
NEXT_PUBLIC_ABOUT_DETAILS_TEXT=
# Core focus entries separated by comma, pipe, or new lines
NEXT_PUBLIC_ABOUT_CORE_FOCUS=

# WordCloud concepts override (JSON array). Leave empty to use src/domains/word-cloud/model/default-concepts.json.
# Format: [{"id":"systems-design","label":"Systems Design","weight":5,"description":"...","relatedKeywords":["Microservices"],"technologies":[{"name":"GraphQL","icon":"GraphQLIcon"}],"companies":["Mercado Libre"]}]
NEXT_PUBLIC_WORD_CLOUD_CONCEPTS=

# -----------------------------------------------------------------------------
# CUSTOMERS / CLIENTS (JSON array for slider)
# -----------------------------------------------------------------------------
# Format: [{"name":"Company","logo":"/images/customers/company.png"}]
# Leave empty to use default mock data
NEXT_PUBLIC_CUSTOMERS=

# -----------------------------------------------------------------------------
# NAVIGATION ITEMS (JSON array)
# -----------------------------------------------------------------------------
# Format: [{"label":"Home","href":"/"},{"label":"About","href":"/about"}]
# Leave empty to use default mock data
NEXT_PUBLIC_NAV_ITEMS=

# -----------------------------------------------------------------------------
# UI / UX SETTINGS
# -----------------------------------------------------------------------------
# Transition Animation - Pause duration (ms) when curtain covers screen
NEXT_PUBLIC_TRANSITION_PAUSE_MS=

# -----------------------------------------------------------------------------
# AUTHENTICATION / OAUTH
# -----------------------------------------------------------------------------
# Set to "true" when Rails backend OAuth is ready
# Vercel release without auth should use: NEXT_PUBLIC_OAUTH_ENABLED=false
NEXT_PUBLIC_OAUTH_ENABLED=false

# -----------------------------------------------------------------------------
# API CONFIGURATION (Production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_HOST=
NEXT_PUBLIC_BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# SITE URL (server-side)
# -----------------------------------------------------------------------------
# Used by next-sitemap for robots.txt and sitemap generation.
# Also used for Open Graph meta tags (og:url).
# Must be the full production URL (e.g., https://yourdomain.com).
# If missing, sitemap defaults to localhost:3000.
SITE_URL=

# -----------------------------------------------------------------------------
# LEGACY (will be removed) -- kept for backward compat
# -----------------------------------------------------------------------------
# PROFILE_EMAIL: Use NEXT_PUBLIC_CONTACT_EMAIL instead (CI sets to test@ci.local)
PROFILE_EMAIL=

# RESUME_URL: Use NEXT_PUBLIC_RESUME_URL instead
RESUME_URL=

# CALENDLY_URL: Use NEXT_PUBLIC_CALENDLY_USERNAME instead
NEXT_PUBLIC_CALENDLY_URL=

# TELEGRAM_URL: Use NEXT_PUBLIC_TELEGRAM_USERNAME instead
NEXT_PUBLIC_TELEGRAM_URL=

# WHATSAPP_URL: Use NEXT_PUBLIC_WHATSAPP_PHONE instead
NEXT_PUBLIC_WHATSAPP_URL=

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY (Database, APIs)
# -----------------------------------------------------------------------------
WEB_PORT=

DB_PASSWORD=
DB_USER=
DB_NAME=
DB_PORT=
# DB_HOST=localhost

DB_ADMIN_USER=
DB_ADMIN_PASSWORD=
DB_ADMIN_PORT=

# Google OAuth / API
CLIENT_ID=
API_KEY=
GOOGLE_SPREADSHEET_MACRO_ID=
