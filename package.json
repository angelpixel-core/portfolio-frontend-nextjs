{
  "name": "portfolio-frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --port 9000",
    "dev:8000": "next dev --port 8000",
    "dev:portless": "portless run --name portfolio next dev",
    "proxy:portless:https": "portless proxy start --https",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint src --ext ts,tsx,js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx,js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,html}\"",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PLAYWRIGHT_JSON_OUTPUT_NAME=e2e-results.json PLAYWRIGHT_JSON_OUTPUT_DIR=test-results playwright test --reporter=github,json",
    "test:e2e:auth-disabled": "NEXT_PUBLIC_OAUTH_ENABLED=false playwright test e2e/auth-disabled.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "quality:e2e:skip-budget": "node scripts/skip-budget-gate.cjs",
    "validate:full:manual": "export CI=true DEBIAN_FRONTEND=noninteractive GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never HOMEBREW_NO_AUTO_UPDATE=1 GIT_EDITOR=: EDITOR=: VISUAL='' GIT_SEQUENCE_EDITOR=: GIT_MERGE_AUTOEDIT=no GIT_PAGER=cat PAGER=cat npm_config_yes=true PIP_NO_INPUT=1 YARN_ENABLE_IMMUTABLE_INSTALLS=false; npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "validate:projects": "jest --testPathPattern=project/model/__tests__/validate-data --verbose",
    "validate:articles": "jest --testPathPattern=article/model/__tests__/validate-data --verbose",
    "validate:content": "jest --testPathPattern=validate-data --verbose",
    "audit:barrels": "npx tsx scripts/audit-barrels.ts",
    "security:audit:runtime": "node scripts/security-audit-gate.cjs",
    "predeploy": "npm run lint && npm run typecheck && npm test && npm run build",
    "lighthouse": "npx @lhci/cli@0.15.1 autorun",
    "lighthouse:collect": "npx @lhci/cli@0.15.1 collect --url=http://localhost:9000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "local:test": "rm .private/logs/npm-test.log; npm test > .private/logs/npm-test.log 2>&1"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.2",
    "@tanstack/react-query": "^5.90.6",
    "clsx": "^2.1.1",
    "framer-motion": "^10.18.0",
    "next": "^15.5.12",
    "next-sitemap": "4.2.3",
    "plausible-tracker": "^0.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-parallax-tilt": "^1.7.320",
    "react-redux": "^9.2.0",
    "sanitize-html": "^2.17.1",
    "TagCloud": "2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.58.0",
    "@storybook/addon-a11y": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/addon-interactions": "^8.6.17",
    "@storybook/addon-themes": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/nextjs": "^8.6.17",
    "@storybook/react": "^8.6.17",
    "@storybook/test": "^8.6.17",
    "@tanstack/react-query-devtools": "5.91.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "ajv": "^8.18.0",
    "ajv-keywords": "5.1.0",
    "autoprefixer": "^10.4.21",
    "critters": "0.0.23",
    "dotenv": "^17.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.12",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-rulesdir": "0.2.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "storybook": "^8.6.17",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.7.3",
    "webpack": "^5.105.4"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint && npm run format"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "npm run lint",
      "npm run format"
    ]
  }
}
