{
  "name": "portfolio-frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --port 9000",
    "dev:8000": "next dev --port 8000",
    "dev:portless": "portless run --name portfolio next dev",
    "proxy:portless:https": "portless proxy start --https",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,html}\"",
    "test": "jest",
    "test:env:local": "bash scripts/test-env/local.sh",
    "test:env:infra": "bash scripts/test-env/infra.sh",
    "test:env:init": "bash scripts/test-env/init.sh",
    "test:env:all": "bash scripts/test-env/infra.sh && bash scripts/test-env/init.sh",
    "test:env:ci": "bash scripts/test-env/ci.sh",
    "test:e2e": "playwright test",
    "test:e2e:2fa": "NEXT_PUBLIC_2FA_ENABLED=true playwright test e2e/two-factor.spec.ts",
    "test:e2e:ci": "CI=true SKIP_2FA_IN_CI=true PLAYWRIGHT_JSON_OUTPUT_NAME=e2e-results.json PLAYWRIGHT_JSON_OUTPUT_DIR=test-results playwright test --reporter=github,json",
    "test:e2e:auth-disabled": "NEXT_PUBLIC_OAUTH_ENABLED=false playwright test e2e/auth-disabled.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "rm -rf .next/types && tsc --noEmit",
    "quality:e2e:skip-budget": "node scripts/skip-budget-gate.cjs",
    "validate:full:manual": "export CI=true DEBIAN_FRONTEND=noninteractive GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never HOMEBREW_NO_AUTO_UPDATE=1 GIT_EDITOR=: EDITOR=: VISUAL='' GIT_SEQUENCE_EDITOR=: GIT_MERGE_AUTOEDIT=no GIT_PAGER=cat PAGER=cat npm_config_yes=true PIP_NO_INPUT=1 YARN_ENABLE_IMMUTABLE_INSTALLS=false; npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build",
    "validate:projects": "jest --testPathPattern=project/model/__tests__/validate-data --verbose",
    "validate:articles": "jest --testPathPattern=article/model/__tests__/validate-data --verbose",
    "validate:content": "jest --testPathPattern=validate-data --verbose",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-docker": "docker compose exec -T web env DATABASE_URL='postgresql://developer:abc123@db:5432/portfolio_frontend_development' npm run db:migrate",
    "db:migrate:docker:file": "bash scripts/db/local-apply-migration.sh",
    "db:migrate-vercel": "DATABASE_URL='postgresql://<user>:<pass>@<host>:5432/<db>?sslmode=require&uselibpqcompat=true' npm run db:migrate",
    "db:seed:content-admin": "bash scripts/db/seed-content-admin.sh",
    "db:prod:check": "bash scripts/db/prod-check.sh",
    "db:prod:migrate": "bash scripts/db/prod-migrate.sh",
    "db:prod:verify": "bash scripts/db/prod-verify.sh",
    "db:prod:verify:assets:phase2": "bash scripts/db/prod-verify-assets-phase2.sh",
    "db:prod:debug:assets:phase2": "bash scripts/db/prod-debug-assets-phase2.sh",
    "db:prod:repair:assets:phase2": "bash scripts/db/prod-repair-assets-phase2-links.sh",
    "db:prod:audit:assets:phase3": "bash scripts/db/prod-audit-assets-phase3.sh",
    "db:prod:verify:project-assets:phase2": "bash scripts/db/prod-verify-project-assets-phase2.sh",
    "db:prod:audit:project-assets:phase3": "bash scripts/db/prod-audit-project-assets-phase3.sh",
    "db:prod:release": "bash scripts/db/prod-check.sh && bash scripts/db/prod-migrate.sh && bash scripts/db/prod-verify.sh",
    "db:orders:delete:all": "bash scripts/db/orders-delete-all.sh",
    "db:orders:delete:id": "bash scripts/db/orders-delete-by-id.sh",
    "db:subscriptions:delete:id": "bash scripts/db/subscriptions-delete-by-id.sh",
    "db:subscriptions:delete:all": "bash scripts/db/subscriptions-delete-all.sh",
    "auth:generate": "npx auth@latest generate",
    "audit:barrels": "npx tsx scripts/audit-barrels.ts",
    "security:audit:runtime": "node scripts/security-audit-gate.cjs",
    "predeploy": "npm run lint && npm run typecheck && npm test && npm run build",
    "lighthouse": "npx @lhci/cli@0.15.1 autorun",
    "lighthouse:collect": "npx @lhci/cli@0.15.1 collect --url=http://localhost:9000",
    "local:test": "rm .private/logs/npm-test.log; npm test > .private/logs/npm-test.log 2>&1"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.5",
    "@react-spring/parallax": "^9.7.5",
    "@reduxjs/toolkit": "^2.9.2",
    "@tanstack/react-query": "^5.90.6",
    "@vercel/blob": "^2.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^10.18.0",
    "next": "^15.5.15",
    "next-sitemap": "4.2.3",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-parallax-tilt": "^1.7.320",
    "react-redux": "^9.2.0",
    "sanitize-html": "^2.17.3",
    "TagCloud": "2.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.58.0",
    "@tanstack/react-query-devtools": "5.91.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "ajv": "^8.18.0",
    "ajv-keywords": "5.1.0",
    "autoprefixer": "^10.4.21",
    "critters": "0.0.23",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.16",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-rulesdir": "0.2.2",
    "globals": "^15.15.0",
    "husky": "^8.0.3",
    "jest": "^30.3.0",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "webpack": "^5.105.4"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint && npm run format"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "npm run lint",
      "npm run format"
    ]
  },
  "overrides": {
    "defu": "^6.1.7"
  }
}
