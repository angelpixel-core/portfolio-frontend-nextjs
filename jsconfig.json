{
  "compilerOptions": {
    "paths": {
      "@/root/*": ["./*"],
      "@/ui/*": ["./src/ui/*"],
      "@/atoms/*": ["./src/ui/atoms/*"],
      "@/molecules/*": ["./src/ui/molecules/*"],
      "@/organisms/*": ["./src/ui/organisms/*"],
      "@/hoc/*": ["./src/ui/hoc/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/store/*": ["./src/store/*"],
      "@/slices/*": ["./src/store/slices/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/data/*": ["./src/lib/data/*"],
      "@/images/*": ["./public/images/*"],
      "@/css/*": ["./public/css/*"]
    }
  },
  "exclude": ["node_modules"]
}
