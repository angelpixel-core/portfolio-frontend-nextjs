{
  "compilerOptions": {
    "paths": {
      "@/root/*": ["./*"],
      "@/css/*": ["./public/css/*"],
      "@/api/*": ["scr/api/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/data/*": ["./src/lib/data/*"],
      "@/models/*": ["./src/models/*"],
      "@/store/*": ["./src/store/*"],
      "@/slices/*": ["./src/store/slices/*"],
      "@/ui/*": ["./src/ui/*"],
      "@/atoms/*": ["./src/ui/atoms/*"],
      "@/molecules/*": ["./src/ui/molecules/*"],
      "@/organisms/*": ["./src/ui/organisms/*"],
      "@/scripts/*": ["./scripts/*"]
    }
  },
  "exclude": ["node_modules"]
}
