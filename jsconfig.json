{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/app/*": ["src/app/*"],
      "@/app": ["src/app/index.js", "src/app/index.jsx"],

      "@/domains/*": ["src/domains/*"],
      "@/domains": ["src/domains/index.js"],

      "@/styles/*": ["src/styles/*"],
      "@/styles": ["src/styles"],

      "@/lib/*": ["src/lib/*"],
      "@/lib": ["src/lib/index.js"],

      "@/services/*": ["src/services/*"],
      "@/services": ["src/services/index.js"],

      "@/shared/*": ["src/ui/shared/*"],
      "@/shared": ["src/ui/shared/index.js"],

      "@/hooks/*": ["src/hooks/*"],
      "@/hooks": ["src/hooks/index.js"],

      "@/providers/*": ["src/providers/*"],
      "@/providers": ["src/providers/index.js"],

      "@/atoms/*": ["src/ui/atoms/*"],
      "@/atoms": ["src/ui/atoms/index.js"],

      "@/buttons/*": ["src/ui/atoms/buttons/*"],
      "@/buttons": ["src/ui/atoms/buttons/index.js"],

      "@/icons/*": ["src/ui/atoms/icons/*"],
      "@/icons": ["src/ui/atoms/icons/index.js"],

      "@/links/*": ["src/ui/atoms/links/*"],
      "@/links": ["src/ui/atoms/links/index.js"],

      "@/texts/*": ["src/ui/atoms/texts/*"],
      "@/texts": ["src/ui/atoms/texts/index.js"],

      "@/molecules/*": ["src/ui/molecules/*"],
      "@/molecules": ["src/ui/molecules/index.js", "src/ui/molecules/index.jsx"],

      "@/organisms/*": ["src/ui/organisms/*"],
      "@/organisms": ["src/ui/organisms/index.js", "src/ui/organisms/index.jsx"],

      "@/overlays/*": ["src/ui/overlays/*"],
      "@/overlays": ["src/ui/overlays/index.js"],

      "@/state/*": ["src/state/*"],
      "@/state": ["src/state/index.js"],

      "@/conf/*": ["src/config/*"],
      "@/conf": ["src/config/index.js"],


      "@/images/*": ["public/images/*"],
    }
  },
  "exclude": ["node_modules"]
}
