{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/app/*": ["app/*"],
      "@/css/*": ["css/*"],
      "@/hooks/*": ["hooks/*"],
      "@/lib/*": ["lib/*"],
      "@/models/*": ["models/*"],
      "@/services/*": ["services/*"],
      "@/state/*": ["state/*"],
      "@/atoms/*": ["ui/atoms/*"],
      "@/molecules/*": ["ui/molecules/*"],
      "@/organisms/*": ["ui/organisms/*"],
      "@/overlays/*": ["ui/overlays/*"],
      "@/shared/*": ["ui/shared/*"]
    }
  },
  "exclude": ["node_modules"]
}
